{
  "name": "finance-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:watch": "jest --watch",
    "test": "jest -u",
    "test:coverage": "jest --coverage",
    "prepare": "husky install"
  },
  "husky": {
